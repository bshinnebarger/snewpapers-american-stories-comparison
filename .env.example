# Your snewpapers API key (snewpapers.com account settings, "Research API"; starts with eyJ).
# Copy this file to .env and paste the whole key after the =, no quotes.
SNEWPAPERS_API_KEY=
# The LLM that judges the differences (optional step): any OpenAI-compatible service and a model
# that supports structured output (response_format json_schema). Its API key, base URL and model.
# The published benchmarks used https://api.deepinfra.com/v1/openai and deepseek-ai/DeepSeek-V4.1-Flash-1017.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
